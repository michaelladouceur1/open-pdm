<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- eDrawings and its API are Windows-only, and the control is 64-bit. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>edrawings-to-stl</AssemblyName>
    <RootNamespace>EDrawingsToStl</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    Publish a single, self-contained executable so end users need no .NET
    runtime:  dotnet publish -c Release   (see ./publish.cmd, ./publish.ps1 or ./publish.sh).
    Override the target with -p:RuntimeIdentifier=... if you ever need to.
  -->
  <PropertyGroup>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Where the eDrawings interop assembly lives *when building*.

    This is a BUILD-TIME dependency only: at runtime the control is resolved
    from the registry by its CLSID, so the interop DLL is never shipped (the
    interop types are embedded below).

    The location is auto-detected, so a stock eDrawings install needs no
    configuration. Resolution order (first hit wins):

      1. An explicit -p:EDrawingsInteropDir=... (or the EDrawingsInteropDir env var).
      2. The control's COM registration (its InprocServer32), which points at the
         install directory regardless of the eDrawings version or folder layout.
      3. The legacy %ProgramFiles%\SOLIDWORKS Corp\eDrawings layout.
      4. Any versioned %ProgramFiles%\Common Files\eDrawings* layout
         (eDrawings 2024 and newer, e.g. eDrawings2026).

    Override it with a property or an environment variable of the same name:
      dotnet build   -c Release -p:EDrawingsInteropDir="D:\eDrawings"
      set EDrawingsInteropDir=D:\eDrawings && dotnet build -c Release
  -->
  <PropertyGroup>
    <!-- 2. COM registration: HKEY_CLASSES_ROOT\CLSID\{...}\InprocServer32 -> EModelView.dll -->
    <_EDrawingsInprocServer Condition="'$(EDrawingsInteropDir)' == ''">$(Registry:HKEY_CLASSES_ROOT\CLSID\{91CAA896-8C40-484C-84E6-9348C69A82A0}\InprocServer32)</_EDrawingsInprocServer>
    <_EDrawingsInprocDir Condition="'$(_EDrawingsInprocServer)' != ''">$([System.IO.Path]::GetDirectoryName('$(_EDrawingsInprocServer)'))</_EDrawingsInprocDir>
    <EDrawingsInteropDir Condition="'$(EDrawingsInteropDir)' == '' AND '$(_EDrawingsInprocDir)' != '' AND Exists('$(_EDrawingsInprocDir)\eDrawings.Interop.EModelViewControl.dll')">$(_EDrawingsInprocDir)</EDrawingsInteropDir>

    <!-- 3. Legacy layout. -->
    <EDrawingsInteropDir Condition="'$(EDrawingsInteropDir)' == '' AND Exists('$(ProgramFiles)\SOLIDWORKS Corp\eDrawings\eDrawings.Interop.EModelViewControl.dll')">$(ProgramFiles)\SOLIDWORKS Corp\eDrawings</EDrawingsInteropDir>
  </PropertyGroup>

  <!-- 4. Versioned Common Files layout (eDrawings 2024+). Takes the first match;
       the registry step above normally selects the active install already. -->
  <ItemGroup Condition="'$(EDrawingsInteropDir)' == ''">
    <_EDrawingsCommonFiles Include="$(ProgramFiles)\Common Files\eDrawings*\eDrawings.Interop.EModelViewControl.dll" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EDrawingsInteropDir)' == ''">
    <!-- Empty when the glob matched nothing; EnsureEDrawingsInterop then reports it. -->
    <EDrawingsInteropDir>@(_EDrawingsCommonFiles->'%(RootDir)%(Directory)')</EDrawingsInteropDir>
  </PropertyGroup>

  <PropertyGroup>
    <EDrawingsInteropPath>$(EDrawingsInteropDir)\eDrawings.Interop.EModelViewControl.dll</EDrawingsInteropPath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(EDrawingsInteropPath)')">
    <Reference Include="eDrawings.Interop.EModelViewControl">
      <HintPath>$(EDrawingsInteropPath)</HintPath>
      <!-- Compile the interop types into this assembly; do not ship the DLL. -->
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail early and clearly when eDrawings is not installed on the build machine. -->
  <Target Name="EnsureEDrawingsInterop"
          BeforeTargets="ResolveReferences"
          Condition="!Exists('$(EDrawingsInteropPath)')">
    <Error Text="eDrawings interop assembly not found at '$(EDrawingsInteropPath)'. Install eDrawings Viewer, or pass -p:EDrawingsInteropDir=&lt;dir&gt; (or set the EDrawingsInteropDir environment variable). Auto-detection checks the control's COM registration, %ProgramFiles%\Common Files\eDrawings* and %ProgramFiles%\SOLIDWORKS Corp\eDrawings." />
  </Target>

</Project>
